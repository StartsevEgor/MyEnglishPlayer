<Window x:Class="MyEnglishPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="English Player" Height="450" Width="800" Background="Black"
        KeyDown="Window_KeyDown"
        MouseMove="Window_MouseMove">
    <Window.Resources>
        <Style x:Key="SelectableTextStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="MainGrid">
        <MediaElement x:Name="MyPlayer" 
                      LoadedBehavior="Manual" 
                      UnloadedBehavior="Stop" 
                      Stretch="Uniform" 
                      MediaOpened="MyPlayer_MediaOpened"/>

        <Popup x:Name="DictionaryPopup" 
           Placement="MousePoint"
           HorizontalOffset="-20"
           VerticalOffset="10"
           StaysOpen="False" 
           AllowsTransparency="True"
           PopupAnimation="Fade">

            <StackPanel Margin="10">
                <StackPanel.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.2" Color="Black"/>
                </StackPanel.Effect>

                <Border Background="White" CornerRadius="15" Padding="20" MinWidth="240" MaxWidth="350">
                    <StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBox x:Name="PopupWord" 
                                     Text="" 
                                     FontSize="22" 
                                     FontFamily="Segoe UI"
                                     FontWeight="Bold" 
                                     Foreground="#222"
                                     Style="{StaticResource SelectableTextStyle}"/>

                            <TextBox x:Name="PopupTranscription" 
                                     Text="" 
                                     FontSize="16" 
                                     FontFamily="Lucida Sans Unicode"
                                     Foreground="#888" 
                                     Margin="10,0,0,2"
                                     VerticalAlignment="Bottom"
                                     Style="{StaticResource SelectableTextStyle}"/>
                        </StackPanel>

                        <TextBox x:Name="PopupMainDef" 
                                 Text="Загрузка..." 
                                 FontSize="16" 
                                 Foreground="#666" 
                                 Margin="0,5,0,5"
                                 Style="{StaticResource SelectableTextStyle}"/>

                        <Border x:Name="SeparatorLine" Background="#F0F0F0" Height="1" Margin="0,5,0,5" Visibility="Collapsed"/>

                        <TextBox x:Name="PopupRestDefs" 
                                 Text="" 
                                 FontSize="14" 
                                 Foreground="#999" 
                                 Visibility="Collapsed"
                                 Margin="0,0,20,0"
                                 Style="{StaticResource SelectableTextStyle}"/>
                        <Grid HorizontalAlignment="Right" Margin="0,-20,0,0">
                            <Button x:Name="BtnExpand" 
                                    Click="ToggleDetails_Click"
                                    Background="Transparent" 
                                    BorderThickness="0" 
                                    Cursor="Hand"
                                    Visibility="Collapsed"
                                    Width="30" Height="30">
                                <Path Data="M 0 0 L 5 5 L 10 0" Stroke="#666" StrokeThickness="2" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="ArrowRotate" Angle="0" CenterX="5" CenterY="2.5"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Button>
                        </Grid>

                        <Button Click="AddToDictionary_Click"
                                Background="Transparent" 
                                BorderThickness="0" 
                                HorizontalAlignment="Left" 
                                Cursor="Hand"
                                Margin="-5,15,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+" FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,5,3"/>
                                <TextBlock Text="Добавить в словарь" FontSize="14" Foreground="#333" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Border>

                <Path Data="M 0,0 L 10,10 L 20,0 Z" 
                  Fill="White" 
                  HorizontalAlignment="Left" 
                  Margin="25,-1,0,0"/>
            </StackPanel>
        </Popup>

        <Grid VerticalAlignment="Bottom" Margin="0,0,0,80" HorizontalAlignment="Center"
              MouseEnter="Subtitles_MouseEnter" 
              MouseLeave="Subtitles_MouseLeave">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button x:Name="BtnAddPhrase"
                    Grid.Row="0"
                    Content="+" 
                    FontSize="24" 
                    FontWeight="Bold"
                    Foreground="White"
                    Background="#88000000"
                    BorderThickness="0"
                    Width="40" Height="30"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed"
                    Cursor="Hand"
                    Click="BtnAddPhrase_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>

            <StackPanel Grid.Row="1">
                <StackPanel.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="2" Opacity="0.8"/>
                </StackPanel.Effect>

                <TextBlock x:Name="EngSubText" 
                           Foreground="White" 
                           FontSize="36" 
                           FontWeight="Bold"
                           TextWrapping="Wrap" 
                           TextAlignment="Center"/>

                <TextBlock x:Name="RusSubText" 
                           Foreground="#FFDD00" 
                           FontSize="24" 
                           FontWeight="Bold"
                           TextWrapping="Wrap" 
                           TextAlignment="Center"
                           Margin="0,0,0,10"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="PhraseDialogOverlay" Visibility="Collapsed" Background="#AA000000">
            <Border Background="White" CornerRadius="15" HorizontalAlignment="Center" VerticalAlignment="Center" Width="600" Padding="20">
                <StackPanel>
                    <TextBlock Text="Добавить фразу в Anki" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                    <TextBlock Text="Английский (Оригинал)" Foreground="Gray" Margin="0,5"/>
                    <TextBox x:Name="TbPhraseSourceEng" 
                             Style="{StaticResource SelectableTextStyle}" 
                             Foreground="#555" FontStyle="Italic" Margin="0,0,0,5" MaxHeight="60" VerticalScrollBarVisibility="Auto"/>

                    <TextBox x:Name="TbPhraseInputEng" FontSize="16" Padding="5" BorderBrush="#CCC" BorderThickness="1"/>

                    <TextBlock Text="Русский (Контекст: пред. + текущ. + след.)" Foreground="Gray" Margin="0,15,0,5"/>
                    <TextBox x:Name="TbPhraseSourceRus" 
                             Style="{StaticResource SelectableTextStyle}" 
                             Foreground="#555" FontStyle="Italic" Margin="0,0,0,5" MaxHeight="80" VerticalScrollBarVisibility="Auto"/>

                    <TextBox x:Name="TbPhraseInputRus" FontSize="16" Padding="5" BorderBrush="#CCC" BorderThickness="1"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Отмена" Click="BtnCancelPhrase_Click" Padding="15,5" Margin="0,0,10,0" Background="#EEE" BorderThickness="0"/>
                        <Button Content="Сохранить" Click="BtnSavePhrase_Click" Padding="15,5" Background="#4CAF50" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="StatusBar" 
            VerticalAlignment="Bottom" 
            HorizontalAlignment="Left" 
            Margin="20,0,0,70" 
            Background="#AA000000" 
            CornerRadius="5" 
            Padding="10,5"
            Visibility="Collapsed">
                <TextBlock x:Name="StatusText" 
                   Foreground="White" 
                   FontSize="14" 
                   FontWeight="SemiBold"/>
        </Border>

        <Border x:Name="ControlPanel" VerticalAlignment="Bottom" Height="60" Padding="10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#CC000000" />
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="⏯" Width="40" Focusable="False" Click="PlayPause_Click"/>

                <Button Grid.Column="1" Content="-5s" Width="40" Margin="5,0,0,0" Tag="-5" Focusable="False" Click="Seek_Click"/>

                <Button Grid.Column="2" Content="+5s" Width="40" Margin="5,0,0,0" Tag="5" Focusable="False" Click="Seek_Click"/>

                <Slider Grid.Column="3" x:Name="TimeSlider" Margin="10,0" VerticalAlignment="Center"
                        IsMoveToPointEnabled="True"
                        ValueChanged="TimeSlider_ValueChanged" 
                        PreviewMouseLeftButtonDown="Slider_MouseDown"
                        PreviewMouseLeftButtonUp="Slider_MouseUp"/>

                <Button Grid.Column="4" Content="📂" Width="40" Focusable="False" Click="OpenFile_Click"/>

                <Button Grid.Column="5" Content="⛶" Width="40" Margin="5,0,0,0" Focusable="False" Click="ToggleFullscreen_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>